# Copier ce fichier en .env et renseigner les valeurs. Ne jamais versionner .env.
DATABASE_URL=postgresql+psycopg2://utilisateur:motdepasse@localhost:5432/maintenance
SECRET_KEY=changer-cette-valeur-longue-et-aleatoire
ENCRYPTION_KEY=                       # clé Fernet : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCESS_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# IA : mock (réponses fixes, sans appel réseau) ou gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash         # à vérifier dans la documentation officielle
AI_TIMEOUT_SECONDS=30

# Dépôts Git (clones locaux en lecture seule)
GIT_WORKDIR=./var/depots

# E-mail (seulement « mot de passe oublié »). Désactivé par défaut.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.org

# Échéances : nombre de jours avant l'échéance pour notifier
ECHEANCE_JOURS_AVANT=1
